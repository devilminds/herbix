# ============================================================
#  HERBIX  –  Environment Variables
#  Copy this file → rename to .env  (never commit .env to git)
# ============================================================

# ── MongoDB ──────────────────────────────────────────────────
# Option A: Local MongoDB
MONGO_URI=mongodb://localhost:27017/herbix

# Option B: MongoDB Atlas (free cloud) — comment out Option A and use this:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/herbix?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=herbix_super_secret_jwt_key_change_this_in_production_2025

# ── Server ────────────────────────────────────────────────────
PORT=3000

# ── Razorpay (get test keys at https://dashboard.razorpay.com/app/keys) ──
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
